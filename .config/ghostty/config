keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+shift+tab=text:\x1b[27;6;9~
keybind = ctrl+i=text:\x1b[Z
font-size = 13
font-thicken = true
keybind = ctrl+j=unbind
keybind = cmd+enter=ignore
keybind = cmd+backspace=text:\x1b[127;9u
keybind = ctrl+backspace=text:\x17
keybind = alt+backspace=text:\x1b\x7f

# Glass effect transparency
background-opacity = 0.94
background-blur-radius = 15

# Line spacing (cell height adjustment)
adjust-cell-height = 20%
