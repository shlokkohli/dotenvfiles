# Ignore everything by default
*
.DS_Store

# Un-ignore root dotfiles
!.gitignore
!.zshrc
!.zshenv
!Readme.md
!nvim-setup.sh
!Brewfile
!bootstrap.sh
!.stowrc

# Un-ignore config dirs
!.config/
!.config/nvim/
!.config/nvim/**
!.config/ghostty/
!.config/ghostty/**
!.config/tmux/
!.config/tmux/**
!.config/zed/
!.config/zed/**
